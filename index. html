<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Your-Rank</title>

<style>
body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f2f4f7;
}

.header{
    background:#111;
    color:white;
    text-align:center;
    padding:22px 10px;
}

.header h1{
    margin:0;
    font-size:30px;
}

.header p{
    margin:7px 0 0;
    color:#ccc;
}

.container{
    max-width:500px;
    margin:25px auto;
    padding:20px;
}

.card{
    background:white;
    padding:20px;
    border-radius:15px;
    box-shadow:0 3px 12px rgba(0,0,0,0.10);
}

label{
    display:block;
    margin-top:15px;
    margin-bottom:6px;
    font-weight:bold;
}

input,select{
    width:100%;
    box-sizing:border-box;
    padding:13px;
    border:1px solid #ccc;
    border-radius:8px;
    font-size:16px;
}

button{
    width:100%;
    padding:14px;
    margin-top:22px;
    border:0;
    border-radius:8px;
    background:#111;
    color:white;
    font-size:17px;
    font-weight:bold;
}

.info{
    margin-top:18px;
    padding:12px;
    background:#f5f5f5;
    border-radius:8px;
    font-size:14px;
    color:#555;
}
</style>
</head>

<body>

<div class="header">
    <h1>YOUR-RANK</h1>
    <p>TCS Exam Rank & Score Analysis</p>
</div>

<div class="container">

<div class="card">

<label>TCS Response Sheet URL</label>

<input
type="url"
id="responseURL"
placeholder="Paste your TCS response sheet URL">

<label>Category</label>

<select id="category">
    <option value="">Select Category</option>
    <option>OPEN</option>
    <option>SC</option>
    <option>ST</option>
    <option>OBC</option>
    <option>VJ-A</option>
    <option>NT-B</option>
    <option>NT-C</option>
    <option>NT-D</option>
    <option>SEBC</option>
    <option>EWS</option>
</select>

<label>Gender</label>

<select id="gender">
    <option value="">Select Gender</option>
    <option>Male</option>
    <option>Female</option>
    <option>Other</option>
</select>

<label>Horizontal Reservation</label>

<select id="horizontal">
    <option value="None">None</option>
    <option>Female</option>
    <option>Ex-Serviceman</option>
    <option>PwD</option>
    <option>Other</option>
</select>

<button onclick="submitForm()">SUBMIT</button>

<div class="info">
Your response sheet will be analysed automatically after submission.
</div>

</div>

</div>

<script>

function submitForm(){

    const url = document.getElementById("responseURL").value;
    const category = document.getElementById("category").value;
    const gender = document.getElementById("gender").value;
    const horizontal = document.getElementById("horizontal").value;

    if(!url){
        alert("Please paste your TCS Response Sheet URL.");
        return;
    }

    if(!category){
        alert("Please select your Category.");
        return;
    }

    if(!gender){
        alert("Please select your Gender.");
        return;
    }

    alert(
        "Form received!\n\n" +
        "URL: " + url +
        "\nCategory: " + category +
        "\nGender: " + gender +
        "\nHorizontal Reservation: " + horizontal
    );
}

</script>

</body>
</html>
